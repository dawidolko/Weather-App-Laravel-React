# Docker Compose Override Example
# 
# Use this file for local customisation without changing the main docker-compose.yml
# Copy this file to docker-compose.override.yml and adjust as needed
#
# docker-compose uses it automatically if it exists
# NIE commituj docker-compose.override.yml do repozytorium!

version: '3.8'

services:
  # Example: extra environment variables for the backend
  backend:
    environment:
      - APP_DEBUG=true
      - LOG_LEVEL=debug
    # Example: map an extra port
    # ports:
    #   - "8001:80"

  # Example: change the frontend port
  frontend:
    # ports:
    #   - "3000:5173"
    environment:
      - VITE_API_URL=http://localhost:8000

  # Example: change the MySQL port
  mysql:
    # ports:
    #   - "3308:3306"
    environment:
      MYSQL_ROOT_PASSWORD: your_custom_password

  # Example: add an extra container (e.g. Redis)
  # redis:
  #   image: redis:7-alpine
  #   container_name: weather-app-redis
  #   ports:
  #     - "6379:6379"
  #   networks:
  #     - weather-app-network
